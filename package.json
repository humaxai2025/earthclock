{
  "name": "earthclock",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "A beautiful clock that displays real-time environmental data alongside time",
  "keywords": [
    "climate",
    "environment",
    "react",
    "vite",
    "clock",
    "sustainability"
  ],
  "author": "Your Name",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{js,jsx,css,md}\"",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "deploy:vercel": "vercel --prod",
    "deploy:netlify": "netlify deploy --prod"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.90.7",
